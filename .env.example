# Скопируйте в .env и заполните. Файл .env в git и в образ не попадает.

# Подложка Mapbox на карте скоринга. Только публичный токен pk.… с ограничением
# по домену сайта (кабинет Mapbox → Tokens → URL restrictions). Пусто — только OSM.
MAPBOX_TOKEN=
MAPBOX_STYLE=okamidan/cmqupgwnh000b01s41y4r8ams

# Домен для HTTPS (профиль https: Caddy + Let's Encrypt), например krt.example.ru
KRT_DOMAIN=

# Порт сайта на 127.0.0.1 сервера (для своего прокси). По умолчанию 8080.
KRT_PORT=8080

# 1 — открыть сайт без пароля. Данные конфиденциальные: только осознанно.
KRT_PUBLIC=0
